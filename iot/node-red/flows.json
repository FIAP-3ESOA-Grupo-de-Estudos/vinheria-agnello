	{
		"id": "mqtt_debug",
		"type": "debug",
		"z": "iot_tab",
		"name": "Depuração MQTT",
		"active": true,
		"tosidebar": true,
		"console": false,
		"tostatus": false,
		"complete": "true",
		"targetType": "full",
		"statusVal": "",
		"statusType": "auto",
		"x": 600,
		"y": 60,
		"wires": []
	},
	{
		"id": "split_sensors",
		"type": "function",
		"z": "iot_tab",
		"name": "Separar leituras",
		"func": "const sensor = String(msg.topic || '').split('/').pop();\nconst payload = msg.payload || {};\nconst outputs = [null, null, null];\n\nfunction numberOrNull(value) {\n    const number = Number(value);\n    return Number.isFinite(number) ? number : null;\n}\n\nfunction reading(value, name, label) {\n    return {\n        topic: name,\n        payload: value,\n        sensor: name,\n        chartLabel: label,\n        source: msg.topic\n    };\n}\n\nif (sensor === 'dht22') {\n    const temperature = numberOrNull(payload.temperature);\n    const humidity = numberOrNull(payload.humidity);\n    if (temperature !== null) {\n        outputs[0] = reading(temperature, 'temperature', 'Temperatura');\n    }\n    if (humidity !== null) {\n        outputs[1] = reading(humidity, 'humidity', 'Umidade relativa');\n    }\n}\n\nif (sensor === 'photoresistor') {\n    const luminosity = numberOrNull(payload.luminosity);\n    if (luminosity !== null) {\n        outputs[2] = reading(luminosity, 'luminosity', 'Luminosidade relativa');\n    }\n}\n\nreturn outputs;",
		"outputs": 3,
		"timeout": 0,
		"noerr": 0,
		"initialize": "",
		"finalize": "",
		"libs": [],
		"x": 610,
		"y": 120,
		"wires": [
			["temperature_gauge", "temperature_chart"],
			["humidity_gauge", "humidity_chart"],
			["luminosity_gauge", "luminosity_chart"]
		]
	},
